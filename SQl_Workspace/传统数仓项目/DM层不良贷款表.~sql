----创建不良贷款存储过程
CREATE OR REPLACE PROCEDURE SP_BLDK
IS
BEGIN
----清空风险客户表
EXECUTE IMMEDIATE 'TRUNCATE TABLE M_RISK_BADLOAN_INFO';
--往风险客户表插入数据
INSERT INTO M_RISK_BADLOAN_INFO

SELECT 
DKKB.LOANACNO
,DKKB.ECIF_CUST_NO
,DKKB.CUSTNAME
,DKKB.CURRSIGN
,DKKB.LOANKIND
,DKKB.FUNDSOUR
,DKKB.LOANUSE
,DKKB.ASSUKIND
,DKKB.CONTDATE
,DKKB.CREDCAPI
,DKKB.SUM_TRAN_AMT
,DKKB.SUM_PAY_AMT
,DKKB.LN_BALANCE
,DKKB.TCAPI
,DKKB.THISTCAPI
,DKKB.CREDAMT
,DKKB.ASSUAMT
,DKKB.IMPAAMT
,DKKB.MORTAMT
,DKKB.CREDTOTALAMT
,DKKB.TERMFREQ
,DKKB.TTERM
,DKKB.RETUTYPE
,DKKB.TROTHDUEDAY
,DKKB.FIXRATETERM
,DKKB.FIRSTDUEDATE
,DKKB.SUBSFLAG
,DKKB.RELEWAY
,DKKB.LOANSTATE

FROM BI_DW.F_LN_LION_INFO DKKB
---条件1 --放款总金额>授信总额度  SUM_TRAN_AMT>CREDTOTALAMT
--如果该客户同时在风险客户和贷款宽表中存在即不良贷款  关联风险客户表
WHERE EXISTS(SELECT 1 FROM M_RISK_CUST_INFO M WHERE M.ECIF_CUST_NO=DKKB.ECIF_CUST_NO)
OR EXISTS(SELECT 1 FROM BI_DW.F_LN_LION_INFO B WHERE SUM_TRAN_AMT>B.CREDTOTALAMT AND DKKB.ECIF_CUST_NO = B.ECIF_CUST_NO);

END SP_BLDK;


--调用
BEGIN
  SP_BLDK();
END;

