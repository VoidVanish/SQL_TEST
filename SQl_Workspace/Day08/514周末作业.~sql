/*
SELECT T.CID,
       COUNT(T.八十五到一百) 八十五到一百,
       COUNT(T.七十到八十五) 七十到八十五,
       COUNT(T.六十到七十) 六十到七十,
       COUNT(T.不及格) 不及格
