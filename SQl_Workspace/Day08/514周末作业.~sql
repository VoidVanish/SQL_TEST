                  FROM SC50 SC1
                 WHERE SC.CID = SC1.CID
                   AND SC1.SCORE BETWEEN 0 AND 59
                 GROUP BY SC.CID) / COUNT(*) "[0-60]"
          FROM SC50 SC
         GROUP BY CID) T
    ON CO.CID = T.CID
    
