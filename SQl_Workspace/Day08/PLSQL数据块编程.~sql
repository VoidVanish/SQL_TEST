
--传入一个员工员工编号,输出他的岗位名称
DECLARE
  V_JOB   VARCHAR2(20);
  V_EMPNO NUMBER := &输入编号;
BEGIN
  SELECT JOB INTO V_JOB FROM EMP WHERE EMPNO = V_EMPNO;
  DBMS_OUTPUT.put_line(V_JOB);
END;

--传入一个部门编号,输出该员工所在部门的平均工资

DECLARE
  V_AVGSAL  NUMBER;
  V_DEPTNO NUMBER := &输入编号;
BEGIN
  SELECT AVG(SAL) INTO V_AVGSAL FROM EMP WHERE DEPTNO = V_DEPTNO;
  DBMS_OUTPUT.put_line(V_AVGSAL);
END;

--传入一个员工编号,打印他所在的部门名称

DECLARE
  V_EMPNO   NUMBER := &输入编号;
  V_DEPNAME VARCHAR2(20);
BEGIN
  SELECT DNAME INTO V_DEPNAME
    FROM DEPT D
    JOIN (SELECT DEPTNO FROM EMP WHERE EMPNO = V_EMPNO) T
      ON D.DEPTNO = T.DEPTNO;
   DBMS_OUTPUT.put_line(V_DEPNAME);
END;
  

