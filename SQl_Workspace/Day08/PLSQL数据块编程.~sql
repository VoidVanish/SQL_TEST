----求圆面积与半径
DECLARE
      C_PAI CONSTANT NUMBER:=3.14;
      V_R NUMBER:=&输入半径;
      V_MIANJI NUMBER;
      V_ZHOUCHANG NUMBER;
BEGIN
  V_MIANJI := C_PAI*V_R*V_R;
  V_ZHOUCHANG:= 2*C_PAI*V_R;
  DBMS_OUTPUT.put_LINE(C_PAI);
  DBMS_OUTPUT.put_line(V_MIANJI);
  DBMS_OUTPUT.put_line(V_ZHOUCHANG);
  END;








---------------------IF判断-----------------------
DECLARE 
V_EMPNO VARCHAR2(20):=&员工编号;
V_COMM NUMBER;
V_ENAME VARCHAR2(20);
V_SAL NUMBER;
V_COMM NUMBER;

BEGIN
  SELECT ENAME,SAL INTO V_ENAME,V_SAL FROM EMP WHERE EMPNO=V_EMPNO;
  IF V_SAL < 1000 THEN
    UPDATE EMP1 SET COMM = NVL(COMM,0)+300 WHERE EMPNO=V_EMPNO;
  END IF;
DBMS_OUTPUT.put_line(V_SAL) ;
END;

