输入两个员工编号将工资高的这个员工的名字打印出来。
(相同打印两人姓名  禁止输入两个相同员工编号)
V_A EMP%ROWTYPE;

DECLARE 
V_EMPNO1 VARCHAR2(20):=&输入员工编号1;
V_EMPNO2 VARCHAR2(20):=&输入员工编号2;
V_ENAME1 VARCHAR2(20);
V_ENAME2 VARCHAR2(20);
V_SAL1 NUMBER;
V_SAL2 NUMBER;
BEGIN
  SELECT ENAME,SAL INTO V_ENAME1,V_SAL1 FROM EMP1 WHERE EMPNO = V_EMPNO1;
  SELECT ENAME,SAL INTO V_ENAME2,V_SAL2 FROM EMP1 WHERE EMPNO = V_EMPNO2;  
  IF V_ENAME1=V_ENAME2 THEN DBMS_OUTPUT.put_line('禁止输入相同的员工编号!') ;
  ELSE
    IF V_SAL1>V_SAL2 THEN DBMS_OUTPUT.put_line(V_ENAME1) ;
    ELSIF V_SAL1<V_SAL2 THEN DBMS_OUTPUT.put_line(V_ENAME2) ;
    ELSE DBMS_OUTPUT.put_line(V_ENAME1||V_ENAME2) ;
    END IF;
    END IF;
END;


传入一个员工编号，打印出这个工资对应的等级，2000以下C，
2000-3000是B，3000以上是A

DECLARE 
V_EMPNO VARCHAR2(20):=&输入员工编号;
V_GRADE VARCHAR2(20);
V_SAL NUMBER;

BEGIN
  SELECT SAL INTO V_SAL FROM EMP1 WHERE EMPNO = V_EMPNO;
  --SELECT GRADE INTO V_GRADE FROM SALGRADE WHERE GRADE BETWEEN LOSAL AND HISAL;
  IF V_SAL BETWEEN 0 AND 1999 THEN V_GRADE := 'C';
  ELSIF V_SAL BETWEEN 2000 AND 2999 THEN V_GRADE := 'B';
  ELSIF V_SAL >= 3000 THEN V_GRADE := 'A';
    END IF;
  DBMS_OUTPUT.put_line(V_SAL||V_GRADE) ;
END;


