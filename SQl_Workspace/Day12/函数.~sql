CREATE OR REPLACE FUNCTION FUN_SUBNUMB(P_CHAR VARCHAR2) RETURN NUMBER IS
V_AFTNUM NUMBER(20);
BEGIN
  FOR I IN 1 .. LENGTH(P_CHAR) LOOP
  V_AFTNUM:=V_AFTNUM||(REGEXP_SUBSTR(P_CHAR,'\d',1,I));
  END LOOP;
  RETURN V_AFTNUM;
END;

