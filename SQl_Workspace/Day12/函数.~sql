CREATE OR REPLACE FUNCTION FUN_EXPTSAL(P_EMPNO NUMBER) RETURN NUMBER IS
V_DEPTNO VARCHAR2(20);
V_BFROSAL NUMBER; ---前工资
V_AFTSAL NUMBER;  ---后工资
BEGIN
  SELECT DEPTNO,SAL INTO V_DEPTNO,V_BFROSAL FROM EMP1 WHERE EMPNO = P_EMPNO;
